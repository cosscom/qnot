# All optional. Defaults suit local development.

# Public origin, used for canonical URLs, OG images, the sitemap, llms.txt and registry URLs.
# Defaults to the Vercel production URL, then http://localhost:5192.
NEXT_PUBLIC_SITE_URL=

# Mount path when the site lives under another one (coss.com/qnot → /qnot). Also sets Next's basePath.
NEXT_PUBLIC_BASE_PATH=

# Where the source lives: every GitHub link and the license header in registry files.
NEXT_PUBLIC_REPO_URL=https://github.com/cosscom/qnot

# Import prefix of the packages, as shown in docs, code panels, install commands and registry files.
# "@qnot/" gives @qnot/core, @qnot/react…; "@coss/qnot/" gives @coss/qnot/core, @coss/qnot/react…
# (installs then name the single package @coss/qnot).
NEXT_PUBLIC_PACKAGE_PREFIX=@qnot/
