{
  "name": "@qnot/svelte",
  "version": "0.0.0",
  "description": "Svelte 5 bindings for qnot: rune-friendly reactive helpers plus a tiny unstyled <QueryBuilder>.",
  "keywords": [
    "svelte",
    "svelte5",
    "query builder",
    "runes"
  ],
  "license": "MIT",
  "homepage": "https://github.com/sean-brydon/trawlnet#readme",
  "bugs": {
    "url": "https://github.com/sean-brydon/trawlnet/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sean-brydon/trawlnet.git",
    "directory": "packages/svelte"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "svelte": "./dist/index.js",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "svelte": "./dist/index.js",
        "default": "./dist/index.js"
      }
    },
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "svelte-package -i src -o dist",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@qnot/core": "workspace:*"
  },
  "peerDependencies": {
    "svelte": "^5.7.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "jsdom": "^27.0.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3"
  },
  "svelte": "./src/index.ts"
}
