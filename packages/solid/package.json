{
  "name": "@qnot/solid",
  "version": "0.0.0",
  "description": "Solid bindings for qnot: fine-grained primitives plus a tiny unstyled <QueryBuilder>.",
  "keywords": [
    "solid",
    "solidjs",
    "query builder",
    "signals"
  ],
  "license": "MIT",
  "homepage": "https://github.com/cosscom/qnot#readme",
  "bugs": {
    "url": "https://github.com/cosscom/qnot/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cosscom/qnot.git",
    "directory": "packages/solid"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.tsx",
      "solid": "./src/index.tsx",
      "default": "./src/index.tsx"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "solid": "./dist/index.jsx",
        "default": "./dist/index.jsx"
      }
    },
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@qnot/core": "workspace:*"
  },
  "peerDependencies": {
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "@solidjs/testing-library": "^0.8.10",
    "jsdom": "^27.0.0",
    "solid-js": "^1.9.17",
    "typescript": "^6.0.3"
  }
}
