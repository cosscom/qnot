{
  "name": "@qnot/react",
  "version": "0.1.0",
  "description": "React bindings for qnot: headless hooks plus a tiny unstyled <QueryBuilder>.",
  "keywords": [
    "react",
    "query builder",
    "hooks",
    "headless",
    "filter"
  ],
  "license": "MIT",
  "homepage": "https://github.com/cosscom/qnot#readme",
  "bugs": {
    "url": "https://github.com/cosscom/qnot/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cosscom/qnot.git",
    "directory": "packages/react"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@qnot/core": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^27.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
