{
  "name": "@qnot/vue",
  "version": "0.0.0",
  "description": "Vue 3 bindings for qnot: composables plus a tiny unstyled <QueryBuilder>.",
  "keywords": [
    "vue",
    "query builder",
    "composables",
    "headless"
  ],
  "license": "MIT",
  "homepage": "https://github.com/cosscom/qnot#readme",
  "bugs": {
    "url": "https://github.com/cosscom/qnot/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cosscom/qnot.git",
    "directory": "packages/vue"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@qnot/core": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^27.0.0",
    "vue": "^3.5.44"
  }
}
