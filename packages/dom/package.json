{
  "name": "@qnot/dom",
  "version": "0.0.0",
  "description": "Vanilla DOM renderer for qnot: no framework, per-node patching.",
  "keywords": [
    "query builder",
    "vanilla",
    "dom",
    "no framework"
  ],
  "license": "MIT",
  "homepage": "https://github.com/cosscom/qnot#readme",
  "bugs": {
    "url": "https://github.com/cosscom/qnot/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cosscom/qnot.git",
    "directory": "packages/dom"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@qnot/core": "workspace:*"
  },
  "devDependencies": {
    "jsdom": "^27.0.0"
  }
}
